# Copy this file to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars to version control.

aws_region  = "us-east-1"
project     = "businessconnect"
environment = "dev"

better_auth_secret = "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
db_password        = "CHANGE_ME_STRONG_DB_PASSWORD"
frontend_url       = "http://localhost:3000"   # replace with ALB DNS after first apply

ecs_service_desired_count = 2

eks_version            = "1.31"
eks_node_instance_type = "t3.medium"
eks_node_min           = 2
eks_node_max           = 4
eks_node_desired       = 2
